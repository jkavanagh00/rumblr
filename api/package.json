{
  "name": "api",
  "private": true,
  "version": "1.0.0",
  "main": "src/index.js",
  "type": "module",
  "engines": {
    "node": "^20.12.1",
    "npm": "^10.5.0"
  },
  "scripts": {
    "dev": "nodemon src/index.mjs",
    "start": "node src/index.mjs",
    "db:migrate": "knex --knexfile src/config/knexfile.js migrate:latest",
    "db:rollback": "knex --knexfile src/config/knexfile.js migrate:rollback",
    "db:seed": "knex --knexfile src/config/knexfile.js seed:run",
    "format": "npx prettier . --write",
    "check": "npx eslint . --fix",

    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest",
    "test:model": "npm run test -- __tests__/unit/models",
    "test:controller": "npm run test -- __tests__/unit/controllers",
    "test:integration": "npm run test -- __tests__/integration",
    
    "test:statements": "npm run test -- __tests__/unit/models/statements.test.js __tests__/unit/controllers/statements.test.js __tests__/integration/statements.test.js",
    "test:statements:model": "npm run test -- __tests__/unit/models/statements.test.js",
    "test:statements:controller": "npm run test -- __tests__/unit/controllers/statements.test.js",
    "test:statements:integration": "npm run test -- __tests__/integration/statements.test.js",
    
    "test:users": "npm run test -- __tests__/unit/models/users.test.js __tests__/unit/controllers/users.test.js __tests__/integration/users.test.js",
    "test:users:model": "npm run test -- __tests__/unit/models/users.test.js",
    "test:users:controller": "npm run test -- __tests__/unit/controllers/users.test.js",
    "test:users:integration": "npm run test -- __tests__/integration/users.test.js",
    
    "test:chats": "npm run test -- __tests__/unit/models/chats.test.js __tests__/unit/controllers/chats.test.js __tests__/integration/chats.test.js",
    "test:chats:model": "npm run test -- __tests__/unit/models/chats.test.js",
    "test:chats:controller": "npm run test -- __tests__/unit/controllers/chats.test.js",
    "test:chats:integration": "npm run test -- __tests__/integration/chats.test.js",
    
    "test:mismatches": "npm run test -- __tests__/unit/models/mismatches.test.js __tests__/unit/controllers/mismatches.test.js __tests__/integration/mismatches.test.js",
    "test:mismatches:model": "npm run test -- __tests__/unit/models/mismatches.test.js",
    "test:mismatches:controller": "npm run test -- __tests__/unit/controllers/mismatches.test.js",
    "test:mismatches:integration": "npm run test -- __tests__/integration/mismatches.test.js"
  },
  "dependencies": {
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.1.0",
    "mysql2": "^3.10.0",
    "pg": "^8.11.5",
    "socket.io": "^4.8.3",
    "sqlite3": "^5.1.7",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "jest": "^30.4.2",
    "nodemon": "^3.1.0",
    "prettier": "^3.2.5",
    "supertest": "^7.2.2"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {},
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ],
    "setupFilesAfterEnv": [
      "./__tests__/setup/jest.setup.js"
    ]
  }
}
