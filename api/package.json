{
  "name": "api",
  "private": true,
  "version": "1.0.0",
  "main": "src/index.js",
  "type": "module",
  "engines": {
    "node": "^20.12.1",
    "npm": "^10.5.0"
  },
  "scripts": {
    "dev": "nodemon src/index.mjs",
    "start": "node src/index.mjs",
    "db:migrate": "knex --knexfile src/config/knexfile.js migrate:latest",
    "db:rollback": "knex --knexfile src/config/knexfile.js migrate:rollback",
    "db:seed": "knex --knexfile src/config/knexfile.js seed:run",
    "format": "npx prettier . --write",
    "check": "npx eslint . --fix",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest",
    "test:model": "npm run test -- __tests__/unit/models",
    "test:controller": "npm run test -- __tests__/unit/controllers",
    "test:middleware": "npm run test -- __tests__/unit/middlewares",
    "test:utils": "npm run test -- __tests__/unit/utils",
    "test:integration": "npm run test -- __tests__/integration",
    "test:auth": "npm run test -- __tests__/unit/controllers/auth.test.js __tests__/unit/middlewares/auth.test.js __tests__/integration/routes/auth.test.js",
    "test:auth:controller": "npm run test -- __tests__/unit/controllers/auth.test.js",
    "test:auth:middleware": "npm run test -- __tests__/unit/middlewares/auth.test.js",
    "test:auth:integration": "npm run test -- __tests__/integration/routes/auth.test.js",
    "test:messages": "npm run test -- __tests__/unit/models/messages.test.js __tests__/unit/controllers/messages.test.js __tests__/integration/routes/messages.test.js",
    "test:messages:model": "npm run test -- __tests__/unit/models/messages.test.js",
    "test:messages:controller": "npm run test -- __tests__/unit/controllers/messages.test.js",
    "test:messages:integration": "npm run test -- __tests__/integration/routes/messages.test.js",
    "test:mismatches": "npm run test -- __tests__/unit/models/mismatches.test.js __tests__/unit/controllers/mismatches.test.js __tests__/integration/routes/mismatches.test.js",
    "test:mismatches:model": "npm run test -- __tests__/unit/models/mismatches.test.js",
    "test:mismatches:controller": "npm run test -- __tests__/unit/controllers/mismatches.test.js",
    "test:mismatches:integration": "npm run test -- __tests__/integration/routes/mismatches.test.js",
    "test:requests": "npm run test -- __tests__/unit/models/requests.test.js __tests__/unit/controllers/requests.test.js __tests__/integration/routes/requests.test.js",
    "test:requests:model": "npm run test -- __tests__/unit/models/requests.test.js",
    "test:requests:controller": "npm run test -- __tests__/unit/controllers/requests.test.js",
    "test:requests:integration": "npm run test -- __tests__/integration/routes/requests.test.js",
    "test:requests:service": "npm run test -- __tests__/integration/services/requests.test.js",
    "test:responses": "npm run test -- __tests__/unit/models/responses.test.js __tests__/unit/controllers/responses.test.js __tests__/integration/routes/responses.test.js",
    "test:responses:model": "npm run test -- __tests__/unit/models/responses.test.js",
    "test:responses:controller": "npm run test -- __tests__/unit/controllers/responses.test.js",
    "test:responses:integration": "npm run test -- __tests__/integration/routes/responses.test.js",
    "test:responses:service": "npm run test -- __tests__/integration/services/responses.test.js",
    "test:rumbles": "npm run test -- __tests__/unit/models/rumbles.test.js __tests__/unit/controllers/rumbles.test.js __tests__/integration/routes/rumbles.test.js",
    "test:rumbles:model": "npm run test -- __tests__/unit/models/rumbles.test.js",
    "test:rumbles:controller": "npm run test -- __tests__/unit/controllers/rumbles.test.js",
    "test:rumbles:integration": "npm run test -- __tests__/integration/routes/rumbles.test.js",
    "test:rumbles:service": "npm run test -- __tests__/integration/services/rumbles.test.js",
    "test:statements": "npm run test -- __tests__/unit/models/statements.test.js __tests__/unit/controllers/statements.test.js __tests__/integration/routes/statements.test.js",
    "test:statements:model": "npm run test -- __tests__/unit/models/statements.test.js",
    "test:statements:controller": "npm run test -- __tests__/unit/controllers/statements.test.js",
    "test:statements:integration": "npm run test -- __tests__/integration/routes/statements.test.js",
    "test:users": "npm run test -- __tests__/unit/models/users.test.js __tests__/unit/controllers/users.test.js __tests__/integration/routes/users.test.js",
    "test:users:model": "npm run test -- __tests__/unit/models/users.test.js",
    "test:users:controller": "npm run test -- __tests__/unit/controllers/users.test.js",
    "test:users:integration": "npm run test -- __tests__/integration/routes/users.test.js",
    "test:helpers": "npm run test -- __tests__/unit/utils/helpers.test.js",
    "test:errors": "npm run test -- __tests__/unit/middlewares/errors.test.js"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.3",
    "knex": "^3.1.0",
    "mysql2": "^3.10.0",
    "pg": "^8.11.5",
    "socket.io": "^4.8.3",
    "socket.io-client": "^4.8.3",
    "sqlite3": "^5.1.7",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "cross-env": "^10.1.0",
    "eslint": "^9.0.0",
    "globals": "^15.0.0",
    "jest": "^30.4.2",
    "nodemon": "^3.1.0",
    "prettier": "^3.2.5",
    "supertest": "^7.2.2"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {},
    "testMatch": [
      "**/__tests__/**/*.test.js"
    ],
    "setupFilesAfterEnv": [
      "./__tests__/setup/jest.setup.js"
    ]
  }
}
